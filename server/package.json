    "test": "node --test --test-concurrency=1",
    "test:unit": "node --test tests/money.test.js tests/mutex.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/api.test.js"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "mongoose": "^8.19.1"
  },
  "devDependencies": {
    "supertest": "7.2.2"
  }
}
